[Unit]
Description=Tele Quant 주간사이클 — 급등 수집 (relation-follow)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/quant_spillover/tele_quant
ExecStart=%h/.local/bin/uv run tele-quant relation-follow --market ALL --hours 4 --save
EnvironmentFile=%h/projects/quant_spillover/tele_quant/.env.local
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
