[Unit]
Description=Tele Quant 주간사이클 — 주말 이슈/공시/정책 브리핑 (차트 추천 없음)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/quant_spillover/tele_quant
ExecStart=%h/.local/bin/uv run tele-quant cycle-briefing --slot weekend-issue --send
EnvironmentFile=%h/projects/quant_spillover/tele_quant/.env.local
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
