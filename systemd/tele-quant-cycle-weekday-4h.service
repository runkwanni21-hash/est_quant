[Unit]
Description=Tele Quant 주간사이클 — 평일 4H 퀀터멘탈 관찰 브리핑
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/quant_spillover/tele_quant
ExecStart=%h/.local/bin/uv run tele-quant cycle-briefing --slot weekday-4h --market ALL --send
EnvironmentFile=%h/projects/quant_spillover/tele_quant/.env.local
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
