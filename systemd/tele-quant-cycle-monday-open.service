[Unit]
Description=Tele Quant 주간사이클 — 월요일 07시 보수 브리핑 (주말 갭 리스크 / EXIT 우선)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/quant_spillover/tele_quant
ExecStart=%h/.local/bin/uv run tele-quant cycle-briefing --slot monday-open --market ALL --send
EnvironmentFile=%h/projects/quant_spillover/tele_quant/.env.local
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
