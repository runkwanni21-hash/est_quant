# ══════════════════════════════════════════════════════════════════
#  Tele Quant — 환경변수 설정 파일 (템플릿)
#
#  사용법:
#    이 파일을 .env.local 로 복사 후 아래 항목을 채워넣으세요.
#    Windows: setup.bat 실행 시 자동으로 .env.local 생성됩니다.
#    대시보드 설정 탭에서도 브라우저 내 수정 가능합니다.
#
#  [선택] 표시 항목은 없어도 기본 동작합니다 (해당 기능만 비활성화).
#  절대 API 키를 GitHub에 올리지 마세요 (.gitignore에 보호됩니다).
# ══════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────
# 대시보드 접근 제어 (미설정 시: 인증 없이 누구나 접근 가능)
#   MASTER_KEY = 소유자용, 세션 만료 없음
#   PASSWORD   = 일반 사용자용, 24시간 세션
#   ※ 집 내부 PC 단독 사용 시 비워도 됩니다.
# ─────────────────────────────────────────────────────────────────
DASHBOARD_MASTER_KEY=
DASHBOARD_PASSWORD=


# ─────────────────────────────────────────────────────────────────
# [선택] 텔레그램 발신 봇 (4H 브리핑·급등 알림 자동 전송)
#
#   발급 방법:
#     ① https://t.me/BotFather → /newbot → 이름 입력 → 토큰 복사
#     ② 봇에 /start 후 https://t.me/userinfobot 에서 chat_id 확인
#        그룹/채널: 봇 초대 후 메시지 전송 → chat_id 확인
#
#   봇 없어도 대시보드 조회 기능은 전부 동작합니다.
# ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TARGET_CHAT_ID=
TELEGRAM_SEND_MODE=bot


# ─────────────────────────────────────────────────────────────────
# [선택] 텔레그램 사용자 API (증권사 리포트 채널 자동 수집)
#
#   발급 방법:
#     ① https://my.telegram.org/apps 접속 → 앱 생성
#     ② App api_id (숫자), api_hash (32자리 hex) 복사
#     ③ PHONE: 로그인할 전화번호 (+821012345678 형식)
#
#   ※ 없으면 yfinance + 뉴스 API만으로 동작합니다.
# ─────────────────────────────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=./data
TELEGRAM_INCLUDE_ALL_CHANNELS=false
TELEGRAM_SOURCE_CHATS=KiwoomResearch,HanaResearch,meritz_research


# ─────────────────────────────────────────────────────────────────
# Yahoo Finance (yfinance) — 항상 활성, API 키 불필요
# ─────────────────────────────────────────────────────────────────
YFINANCE_ENABLED=true


# ─────────────────────────────────────────────────────────────────
# [선택] Finnhub — 미국 기업 뉴스 건수 + EPS 서프라이즈
#   발급: https://finnhub.io  (무료 플랜 즉시 발급)
# ─────────────────────────────────────────────────────────────────
FINNHUB_ENABLED=false
FINNHUB_API_KEY=


# ─────────────────────────────────────────────────────────────────
# [선택] DART (OpenDART) — 한국 전자공시 (수주/자사주/실적)
#   발급: https://opendart.fss.or.kr → 인증키 신청 (1~2일 소요)
# ─────────────────────────────────────────────────────────────────
OPENDART_ENABLED=false
OPENDART_API_KEY=
OPENDART_BASE_URL=https://opendart.fss.or.kr/api


# ─────────────────────────────────────────────────────────────────
# [선택] Naver Open API — 국내 뉴스 검색 + 증권 리포트
#   발급: https://developers.naver.com → 오픈 API → 검색 신청
# ─────────────────────────────────────────────────────────────────
NAVER_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_NEWS_SEARCH_URL=https://openapi.naver.com/v1/search/news.json
NAVER_REPORTS_ENABLED=false


# ─────────────────────────────────────────────────────────────────
# [선택] FRED — 미국 연준 매크로 지표 (금리·실업률·CPI)
#   발급: https://fred.stlouisfed.org/docs/api  (무료, 즉시 발급)
# ─────────────────────────────────────────────────────────────────
FRED_ENABLED=false
FRED_API_KEY=


# ─────────────────────────────────────────────────────────────────
# [선택] ECOS — 한국은행 경제통계 (기준금리·통화량·환율)
#   발급: https://ecos.bok.or.kr → 오픈 API 신청 (무료)
# ─────────────────────────────────────────────────────────────────
ECOS_ENABLED=false
ECOS_API_KEY=


# ─────────────────────────────────────────────────────────────────
# [선택] Alpha Vantage — 기술지표 보완
#   발급: https://www.alphavantage.co/support/#api-key  (무료)
# ─────────────────────────────────────────────────────────────────
ALPHAVANTAGE_ENABLED=false
ALPHAVANTAGE_API_KEY=


# ─────────────────────────────────────────────────────────────────
# [선택] NewsAPI — 영어 뉴스 헤드라인
#   발급: https://newsapi.org/register  (무료 100req/day)
# ─────────────────────────────────────────────────────────────────
NEWSAPI_ENABLED=false
NEWSAPI_KEY=


# ─────────────────────────────────────────────────────────────────
# [선택] FMP (Financial Modeling Prep) — EV/EBITDA, FCF, 실적 캘린더
#   발급: https://site.financialmodelingprep.com  (무료 플랜 가능)
# ─────────────────────────────────────────────────────────────────
FMP_ENABLED=false
FMP_API_KEY=


# ─────────────────────────────────────────────────────────────────
# [선택] Ollama — 로컬 AI 모델 (없으면 규칙 기반으로 동작)
#   설치: https://ollama.com → ollama pull qwen3:8b
#   추가 기능: 뉴스 감성 심화 분석, 브리핑 자연어 다듬기
# ─────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TEMPERATURE=0.15
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=180
EMBEDDING_DEDUPE=false


# ─────────────────────────────────────────────────────────────────
# 분석 설정 (기본값 그대로 사용 권장)
# ─────────────────────────────────────────────────────────────────
FETCH_LOOKBACK_HOURS=4
DIGEST_INTERVAL_HOURS=4
MAX_MESSAGES_PER_CHAT=80
MAX_ITEMS_FOR_DIGEST=120
MIN_TEXT_CHARS=20
ANALYSIS_ENABLED=true
ANALYSIS_TOP_CANDIDATES=24
ANALYSIS_MAX_SYMBOLS=40
ANALYSIS_MIN_SCORE_TO_SEND=50
DIGEST_MODE=fast
DETERMINISTIC_FALLBACK=true
RUN_MAX_SECONDS=900


# ─────────────────────────────────────────────────────────────────
# 저장소 / 앱 설정
# ─────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/tele_quant.sqlite
APP_ENV=local
APP_TIMEZONE=Asia/Seoul
OFFLINE_MODE=false
WATCHLIST_ENABLED=true
WATCHLIST_PATH=config/watchlist.yml


# ─────────────────────────────────────────────────────────────────
# 보안 잠금 (절대 변경 금지)
# ─────────────────────────────────────────────────────────────────
ORDER_ENABLED=false
REAL_TRADING_ENABLED=false
KIS_ORDER_ENABLED=false
KIS_REAL_ORDER_ENABLED=false
