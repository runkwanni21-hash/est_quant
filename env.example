# ══════════════════════════════════════════════════════════════
#  Tele Quant  -  환경 설정 파일
#  이 파일을 .env.local 로 복사한 뒤 본인의 키를 입력하세요.
#  대시보드 ⚙ 설정 탭에서도 변경할 수 있습니다.
# ══════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────
# [선택] 대시보드 접근 제어
#   DASHBOARD_MASTER_KEY: 소유자 전용 — 서버 켜진 동안 무제한 세션
#   DASHBOARD_PASSWORD  : 일반 사용자용 — 24시간마다 재로그인 필요
#   둘 다 미설정 시: 인증 없이 누구나 접근 가능
# ─────────────────────────────────────────────────────────────
DASHBOARD_MASTER_KEY=
DASHBOARD_PASSWORD=


# ─────────────────────────────────────────────────────────────
# [발송 시 필요] 텔레그램 발신 봇
#   비어 있어도 --no-send 미리보기와 대시보드는 정상 동작합니다.
#   텔레그램으로 브리핑을 받으려면 아래 두 값을 입력하세요.
#   1) https://t.me/BotFather 에서 /newbot → 토큰 발급
#   2) 봇에 /start 후 https://t.me/userinfobot 으로 내 chat_id 확인
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TARGET_CHAT_ID=
TELEGRAM_SEND_MODE=bot

# ─────────────────────────────────────────────────────────────
# [선택] 텔레그램 채널 수집 (증권사 리포트 자동 수집용)
#   my.telegram.org/apps 에서 API_ID / API_HASH 발급
# ─────────────────────────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=./data/private/tele_quant.session
TELEGRAM_INCLUDE_ALL_CHANNELS=false
TELEGRAM_SOURCE_CHATS=KiwoomResearch,HanaResearch,meritz_research

# ─────────────────────────────────────────────────────────────
# [선택] Ollama - 로컬 AI 모델 (없으면 규칙 기반 분석으로 동작)
#   설치: https://ollama.com  →  ollama pull qwen3:8b
#   Ollama 있을 때 추가되는 기능:
#     · 뉴스/공시 문장 심화 감성 분석
#     · 브리핑 자연어 다듬기 (polish)
#     · 임베딩 기반 중복 뉴스 제거
# ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TEMPERATURE=0.15
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=180
EMBEDDING_DEDUPE=false

# ─────────────────────────────────────────────────────────────
# [기본] Yahoo Finance - 무료, 항상 활성
# ─────────────────────────────────────────────────────────────
YFINANCE_ENABLED=true
YFINANCE_SYMBOLS=^GSPC,^IXIC,^DJI,^VIX,^TNX,DX-Y.NYB,KRW=X,^KS11,^KQ11,005930.KS,000660.KS,NVDA,MSFT,AAPL,TSLA,BTC-USD

# ─────────────────────────────────────────────────────────────
# [선택] Finnhub - 뉴스 / 실적 데이터
#   https://finnhub.io (무료 플랜 가능)
# ─────────────────────────────────────────────────────────────
FINNHUB_ENABLED=false
FINNHUB_API_KEY=

# ─────────────────────────────────────────────────────────────
# [선택] DART (OpenDART) - 한국 전자공시
#   https://opendart.fss.or.kr → 인증키 신청 (1~2일 소요)
#   이 프로젝트는 DART_API_KEY가 아니라 OPENDART_API_KEY를 사용합니다.
# ─────────────────────────────────────────────────────────────
OPENDART_ENABLED=false
OPENDART_API_KEY=
OPENDART_BASE_URL=https://opendart.fss.or.kr/api

# ─────────────────────────────────────────────────────────────
# [선택] Naver - 뉴스 검색 / 증권 리포트
#   https://developers.naver.com → 오픈 API 신청
# ─────────────────────────────────────────────────────────────
NAVER_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_NEWS_SEARCH_URL=https://openapi.naver.com/v1/search/news.json
NAVER_REPORTS_ENABLED=false
NAVER_REPORT_CATEGORIES=company,industry,economy,market
NAVER_REPORTS_PER_CATEGORY=10

# ─────────────────────────────────────────────────────────────
# [선택] FRED - 미국 연준 매크로 지표
#   https://fred.stlouisfed.org/docs/api → API Key 무료 발급
# ─────────────────────────────────────────────────────────────
FRED_ENABLED=false
FRED_API_KEY=

# ─────────────────────────────────────────────────────────────
# [선택] ECOS - 한국은행 경제통계
#   https://ecos.bok.or.kr → 오픈 API 신청
# ─────────────────────────────────────────────────────────────
ECOS_ENABLED=false
ECOS_API_KEY=

# ─────────────────────────────────────────────────────────────
# [선택] Alpha Vantage - 주가/기술지표 데이터
#   https://www.alphavantage.co/support/#api-key (무료)
# ─────────────────────────────────────────────────────────────
ALPHAVANTAGE_ENABLED=false
ALPHAVANTAGE_API_KEY=

# ─────────────────────────────────────────────────────────────
# [선택] NewsAPI - 영어 뉴스
#   https://newsapi.org/register (무료 100req/day)
# ─────────────────────────────────────────────────────────────
NEWSAPI_ENABLED=false
NEWSAPI_KEY=

# ─────────────────────────────────────────────────────────────
# [선택] FMP (Financial Modeling Prep)
#   https://site.financialmodelingprep.com
# ─────────────────────────────────────────────────────────────
FMP_ENABLED=false
FMP_API_KEY=

# ─────────────────────────────────────────────────────────────
# 수집 / 분석 설정
# ─────────────────────────────────────────────────────────────
FETCH_LOOKBACK_HOURS=4
DIGEST_INTERVAL_HOURS=4
MAX_MESSAGES_PER_CHAT=80
MAX_ITEMS_FOR_DIGEST=120
MIN_TEXT_CHARS=20
ANALYSIS_ENABLED=true
ANALYSIS_TOP_CANDIDATES=24
ANALYSIS_MAX_SYMBOLS=40
ANALYSIS_MIN_SCORE_TO_SEND=50
DIGEST_MODE=fast
DETERMINISTIC_FALLBACK=true
RUN_MAX_SECONDS=900

# ─────────────────────────────────────────────────────────────
# 저장소 / 앱 설정
# ─────────────────────────────────────────────────────────────
SQLITE_PATH=./data/private/tele_quant.sqlite
EVENT_PRICE_CSV_PATH=./data/private/event_price_1000d.csv
CORRELATION_CSV_PATH=./data/private/stock_correlation_1000d.csv
APP_ENV=local
APP_TIMEZONE=Asia/Seoul
OFFLINE_MODE=false
WATCHLIST_ENABLED=true
WATCHLIST_PATH=config/watchlist.yml

# ─────────────────────────────────────────────────────────────
# 보안 잠금 (변경하지 마세요)
# ─────────────────────────────────────────────────────────────
ORDER_ENABLED=false
REAL_TRADING_ENABLED=false
KIS_ORDER_ENABLED=false
KIS_REAL_ORDER_ENABLED=false
